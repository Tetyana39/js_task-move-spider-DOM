"use strict";
var wall = document.querySelector(".wall");
var spider = wall.querySelector(".spider");
wall.addEventListener("click", function(e) {
    // Отримуємо прямокутники для стіни та павука
    var wallRect = wall.getBoundingClientRect();
    var spiderRect = spider.getBoundingClientRect();
    // Координати кліку всередині стіни
    var clickX = e.clientX - wallRect.left;
    var clickY = e.clientY - wallRect.top;
    // Центрування павука
    var targetLeft = clickX - spiderRect.width / 2;
    var targetTop = clickY - spiderRect.height / 2;
    // Межі руху (щоб павук не вилазив за стіну)
    var maxX = wallRect.width - spiderRect.width;
    var maxY = wallRect.height - spiderRect.height;
    // Затискання в межах
    if (targetLeft < 0) targetLeft = 0;
    if (targetTop < 0) targetTop = 0;
    if (targetLeft > maxX) targetLeft = maxX;
    if (targetTop > maxY) targetTop = maxY;
    // Присвоюємо стилі (відносно .wall, бо spider — absolute усередині неї)
    spider.style.left = "".concat(targetLeft, "px");
    spider.style.top = "".concat(targetTop, "px");
});

